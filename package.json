{
    "name": "vrclearn-store",
    "version": "0.1.0",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "generate:theme": "node scripts/generate-theme.mjs",
        "generate:font-notices": "node scripts/font-notices.mjs",
        "dev": "npm run generate:theme && vite --host 127.0.0.1 --port 4173",
        "build": "npm run generate:theme && npm run generate:font-notices && npm run check && vite build && node scripts/build-static.mjs",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.edge.json",
        "test": "vitest run",
        "test:browser": "playwright test",
        "types": "wrangler types --config deployment/local-app.jsonc --env-interface AppBindings --include-runtime=false --strict-vars=false app-env.d.ts && wrangler types --config deployment/local-support.jsonc --env-interface SupportBindings --include-runtime=false --strict-vars=false worker-env.d.ts",
        "preview": "vite preview --host 127.0.0.1 --port 4173",
        "preflight": "node scripts/preflight.mjs",
        "dev:worker": "wrangler dev --config deployment/local-support.jsonc",
        "release:test": "node scripts/release.mjs --environment test",
        "release:production": "node scripts/release.mjs --environment production",
        "test:capacity": "vitest run tests/capacity.test.ts"
    },
    "dependencies": {
        "@fontsource-variable/noto-sans": "5.3.0",
        "@fontsource-variable/noto-sans-jp": "5.3.1",
        "@fontsource-variable/noto-sans-sc": "5.3.1",
        "@material-symbols/svg-500": "0.45.8",
        "@material/material-color-utilities": "0.4.0",
        "@material/web": "2.5.0",
        "better-auth": "1.7.13",
        "marked": "^17.0.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router": "^7.9.0",
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.66.0",
        "@cloudflare/workers-types": "latest",
        "@playwright/test": "latest",
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "latest",
        "miniflare": "5.20261023.1-beta",
        "typescript": "latest",
        "vite": "latest",
        "vitest": "latest",
        "wrangler": "latest"
    }
}
