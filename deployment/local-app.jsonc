{
    "compatibility_date": "2026-10-23",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "workers_dev": false,
    "preview_urls": false,
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "local-vrclearn-store",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "../migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "PRIVATE_MEDIA",
            "bucket_name": "local-vrclearn-store-private"
        },
        {
            "binding": "PUBLIC_MEDIA",
            "bucket_name": "local-vrclearn-store-public"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "STATE",
            "id": "00000000000000000000000000000000"
        }
    ],
    "vars": {
        "ORIGIN": "http://127.0.0.1:4173",
        "MEDIA_ORIGIN": "http://127.0.0.1:4173",
        "ENVIRONMENT": "development",
        "DEPLOYMENT_ENV": "local",
        "RELEASE_SHA": "local",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
    },
    "name": "local-vrclearn-store",
    "main": "../app/index.ts",
    "limits": {
        "cpu_ms": 50
    },
    "assets": {
        "directory": "../dist/client",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
        "run_worker_first": [
            "/api/v1",
            "/api/v1/*",
            "/api/auth",
            "/api/auth/*",
            "/en/products/*",
            "/zh-CN/products/*",
            "/ja/products/*",
            "/en/shops/*",
            "/zh-CN/shops/*",
            "/ja/shops/*",
            "/sitemap.xml",
            "/sitemaps/*"
        ]
    },
    "services": [
        {
            "binding": "AUTH",
            "service": "local-vrclearn-store-support"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "QUOTA",
                "class_name": "QuotaGate",
                "script_name": "local-vrclearn-store-support"
            }
        ]
    }
}
