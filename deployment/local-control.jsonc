{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "local-vrclearn-store-account-monitor",
    "main": "../control/index.ts",
    "compatibility_date": "2026-10-26",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "preview_urls": false,
    "limits": { "cpu_ms": 500 },
    "kv_namespaces": [
        { "binding": "STATE", "id": "00000000000000000000000000000000" },
        { "binding": "PRODUCTION_STATE", "id": "11111111111111111111111111111111" },
        { "binding": "TEST_STATE", "id": "22222222222222222222222222222222" }
    ],
    "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["local-noreply@example.com"] }],
    "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaGate" }] },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaGate"] }],
    "vars": {
        "ENVIRONMENT": "development",
        "CF_ACCOUNT_ID": "",
        "CF_ZONE_ID": "",
        "EDGE_RULESET_ID": "",
        "PRODUCTION_ORIGIN": "http://127.0.0.1:8788",
        "PRODUCTION_MEDIA_ORIGIN": "http://127.0.0.1:8788",
        "PRODUCTION_EDGE_RULE_ID": "",
        "PRODUCTION_EDGE_MEDIA_RULE_ID": "",
        "TEST_ORIGIN": "http://127.0.0.1:8789",
        "TEST_MEDIA_ORIGIN": "http://127.0.0.1:8789",
        "TEST_EDGE_RULE_ID": "",
        "TEST_EDGE_MEDIA_RULE_ID": "",
        "EMAIL_FROM": "local-noreply@example.com"
    }
}
