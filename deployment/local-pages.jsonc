{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "local-vrclearn-store",
    "pages_build_output_dir": "../dist",
    "compatibility_date": "2026-10-26",
    "compatibility_flags": ["nodejs_compat"],
    "limits": { "cpu_ms": 50 },
    "d1_databases": [{ "binding": "DB", "database_name": "local-vrclearn-store", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../migrations" }],
    "r2_buckets": [{ "binding": "PRIVATE_MEDIA", "bucket_name": "local-vrclearn-store-private" }, { "binding": "PUBLIC_MEDIA", "bucket_name": "local-vrclearn-store-public" }],
    "kv_namespaces": [{ "binding": "STATE", "id": "00000000000000000000000000000000" }],
    "services": [{ "binding": "AUTH", "service": "local-vrclearn-store-support" }],
    "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaGate", "script_name": "local-vrclearn-store-support" }] },
    "vars": { "SKIP_DEPENDENCY_INSTALL": "1", "ORIGIN": "http://127.0.0.1:8788", "MEDIA_ORIGIN": "http://127.0.0.1:8788", "ENVIRONMENT": "development", "DEPLOYMENT_ENV": "local", "RELEASE_SHA": "local", "TURNSTILE_SITE_KEY": "1x00000000000000000000AA", "CF_ZONE_ID": "" }
}
