{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "vrclearn-store-support",
    "main": "index.ts",
    "compatibility_date": "2026-10-26",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "preview_urls": false,
    "limits": { "cpu_ms": 500 },
    "triggers": { "crons": ["*/15 * * * *"] },
    "observability": { "enabled": true, "head_sampling_rate": 0.01 },
    "vars": {
        "ORIGIN": "https://store.vrclearn.com",
        "MEDIA_ORIGIN": "https://store-media.vrclearn.com",
        "ENVIRONMENT": "production",
        "EMAIL_FROM": "noreply@vrclearn.com",
        "ALERT_EMAIL": "",
        "CF_ACCOUNT_ID": "",
        "CF_ZONE_ID": "",
        "EDGE_RULESET_ID": "",
        "EDGE_RULE_ID": "",
        "EDGE_MEDIA_RULE_ID": "",
        "D1_DATABASE_ID": "",
        "PAGES_PROJECT_NAME": "vrclearn-store",
        "SUPPORT_SCRIPT_NAME": "vrclearn-store-support",
        "PRIVATE_BUCKET_NAME": "vrclearn-store-private",
        "PUBLIC_BUCKET_NAME": "vrclearn-store-public"
    },
    "d1_databases": [{ "binding": "DB", "database_name": "vrclearn-store", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../migrations" }],
    "kv_namespaces": [{ "binding": "STATE", "id": "00000000000000000000000000000000" }],
    "r2_buckets": [
        { "binding": "PRIVATE_MEDIA", "bucket_name": "vrclearn-store-private" },
        { "binding": "PUBLIC_MEDIA", "bucket_name": "vrclearn-store-public" }
    ],
    "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@vrclearn.com"] }],
    "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaGate" }] },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaGate"] }],
    "ratelimits": [{ "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
}
