{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "vrclearn-store-support",
    "main": "index.ts",
    "compatibility_date": "2026-10-26",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "preview_urls": false,
    "limits": { "cpu_ms": 500 },
    "triggers": { "crons": ["*/15 * * * *"] },
    "observability": { "enabled": true, "head_sampling_rate": 0.01 },
    "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "CF_MONITOR_TOKEN", "CF_API_TOKEN", "ALERT_EMAIL"] },
    "vars": {
        "ORIGIN": "https://store.vrclearn.com",
        "MEDIA_ORIGIN": "https://store-media.vrclearn.com",
        "ENVIRONMENT": "production",
        "EMAIL_FROM": "noreply@vrclearn.com",
        "CF_ACCOUNT_ID": "ed7beef1c506866d938a47bc0e96047b",
        "CF_ZONE_ID": "967eddcad533af8ad00b65c307f734af",
        "EDGE_RULESET_ID": "22d16a870c2e4e66adf87c345aa1b38a",
        "EDGE_RULE_ID": "3ad3c0bd3e00476fb7e2c84b50bb4378",
        "EDGE_MEDIA_RULE_ID": "ff04b3a222494e3980beb7cd26ebb401",
        "D1_DATABASE_ID": "61bf6c3f-1e6a-4fca-9a43-6b3552167642",
        "PAGES_PROJECT_NAME": "vrclearn-store",
        "SUPPORT_SCRIPT_NAME": "vrclearn-store-support",
        "PRIVATE_BUCKET_NAME": "vrclearn-store-private",
        "PUBLIC_BUCKET_NAME": "vrclearn-store-public"
    },
    "d1_databases": [{ "binding": "DB", "database_name": "vrclearn-store", "database_id": "61bf6c3f-1e6a-4fca-9a43-6b3552167642", "migrations_dir": "../migrations" }],
    "kv_namespaces": [{ "binding": "STATE", "id": "c0681109ffa94b7b9de3d57cefbc1d32" }],
    "r2_buckets": [
        { "binding": "PRIVATE_MEDIA", "bucket_name": "vrclearn-store-private" },
        { "binding": "PUBLIC_MEDIA", "bucket_name": "vrclearn-store-public" }
    ],
    "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@vrclearn.com"] }],
    "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaGate" }] },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaGate"] }],
    "ratelimits": [{ "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
}
