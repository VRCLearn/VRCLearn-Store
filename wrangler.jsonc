{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "vrclearn-store",
    "pages_build_output_dir": "./dist",
    "compatibility_date": "2026-10-26",
    "compatibility_flags": ["nodejs_compat"],
    "limits": { "cpu_ms": 50 },
    "d1_databases": [{ "binding": "DB", "database_name": "vrclearn-store", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
    "r2_buckets": [
        { "binding": "PRIVATE_MEDIA", "bucket_name": "vrclearn-store-private" },
        { "binding": "PUBLIC_MEDIA", "bucket_name": "vrclearn-store-public" }
    ],
    "kv_namespaces": [{ "binding": "STATE", "id": "00000000000000000000000000000000" }],
    "services": [{ "binding": "AUTH", "service": "vrclearn-store-support" }],
    "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaGate", "script_name": "vrclearn-store-support" }] },
    "vars": {
        "ORIGIN": "https://store.vrclearn.com",
        "MEDIA_ORIGIN": "https://store-media.vrclearn.com",
        "ENVIRONMENT": "production",
        "TURNSTILE_SITE_KEY": "",
        "CF_ZONE_ID": ""
    }
}
